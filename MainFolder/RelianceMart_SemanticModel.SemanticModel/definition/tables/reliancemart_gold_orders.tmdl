table reliancemart_gold_orders
	lineageTag: b3237d77-e2f5-4d1b-83d3-e12d4c5d25ba
	sourceLineageTag: [dbo].[reliancemart_gold_orders]

	measure 'Bar Index' = ```
			
			RANKX(
			    ALL(reliancemart_gold_orders[ProductName]),  
			    CALCULATE(SUM(reliancemart_gold_orders[TotalAmount])),
			    ,
			    ASC,
			    DENSE
			)
			```
		formatString: 0
		lineageTag: 25e86168-a2c3-4d2d-aad8-89d0eb99b2e7

		changedProperty = Name

	measure 'Bar Color' =
			
			IF(
			    MOD([Index], 2) = 0,
			    "#7A9BD1",
			    "#003183"
			)
		lineageTag: 283c0a41-e206-4d90-ab25-2842343f1517

		changedProperty = Name

	measure Index =
			
			RANKX(
			    ALL(reliancemart_gold_orders[ProductName]),
			    CALCULATE(SUM(reliancemart_gold_orders[TotalAmount])),
			    ,
			    DESC,
			    DENSE
			)
		formatString: 0
		lineageTag: 104077df-9451-49e9-8d19-342ab6f40365

		changedProperty = Name

	measure 'Top 5 Products Total' = ```
			
			VAR TopProducts = 
			    TOPN(
			        5,
			        ALL('reliancemart_gold_orders'[ProductName]),
			        CALCULATE(SUM('reliancemart_gold_orders'[TotalAmount])),
			        DESC
			    )
			RETURN
			CALCULATE(
			    SUM('reliancemart_gold_orders'[TotalAmount]),
			    TopProducts
			)
			```
		lineageTag: acca5af1-5755-4ea2-9acc-de9555159806

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Sales' = SUM('reliancemart_gold_orders'[TotalAmount])
		lineageTag: 8b87ba20-7bb6-4f2c-ad30-1afaf5e78a2a

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Products Sold' = SUM(reliancemart_gold_orders[Quantity])
		lineageTag: c5b67a92-e327-42db-a50d-5c09ae0234e5

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Orders' = DISTINCTCOUNT('reliancemart_gold_orders'[OrderID])
		formatString: 0
		lineageTag: 0b42f9ee-af70-45ac-813d-008dafe1f5ee

		changedProperty = Name

	measure 'Total Customers' = DISTINCTCOUNT('reliancemart_gold_orders'[CustomerID])
		formatString: 0
		lineageTag: 17b3c296-f3b9-42e8-9bd4-4629cfddd444

		changedProperty = Name

	measure 'Average Order Value(AOV)' = DIVIDE([Total Sales], [Total Orders])
		lineageTag: 3b5307ad-bf41-463d-a5db-ed32fbcc59dd

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'YoY Growth %' =
			
			DIVIDE(
			    [Total Sales] - CALCULATE([Total Sales], SAMEPERIODLASTYEAR('Date Table'[Date])),
			    CALCULATE([Total Sales], SAMEPERIODLASTYEAR('Date Table'[Date]))
			)
		lineageTag: 216cc0fa-7201-4e53-9449-0663a28d32c1

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

