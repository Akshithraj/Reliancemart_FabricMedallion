	measure Positive_Sentiment(%) =
			
			DIVIDE(
			    CALCULATE(
			        SUM(reliancemart_gold_social_media[count]),
			        reliancemart_gold_social_media[sentiment] = "positive"
			    ),
			    SUM(reliancemart_gold_social_media[count])
			)
		lineageTag: 4a3ac712-10b3-44af-a6b4-1980c7540c1f

